#!/usr/bin/env ruby
# frozen_string_literal: true
# vim: filetype=ruby

require 'grouse'
require 'socket'
require 'tanraku'

# Enaga core in Grouse/lib
class Enaga
  def self.version
    puts 'Enaga core in Grouse VERSION: ' + core_version
  end

  def self.help
    puts 'HELP'.center(60, '-')
    puts ''
    puts 'enaga'
    puts ''
    Enaga.version
    puts ''
    puts 'enaga -a'
    puts ''
    puts "#{udp_socket}"
    puts ''
    puts 'enaga -b'
    puts ''
    puts "#{list_socket}"
    puts ''
    puts 'enaga -c'
    puts ''
    puts "#{eq_socket}"
    puts ''
    puts 'enaga -d'
    puts ''
    puts "#{koyomi}"
    puts ''
    puts 'HELP'.center(60, '-')
  end
end

one = ARGV[0]

a = /\A[-][a]\z/
b = /\A[-][b]\z/
c = /\A[-][c]\z/
d = /\A[-][d]\z/
h = /\A[-][h]\z/

begin
  if one.nil?
    Enaga.version
  elsif one.match?(a)
    puts "#{udp_socket}"
  elsif one.match?(b)
    puts "#{list_socket}"
  elsif one.match?(c)
    puts "#{eq_socket}"
  elsif one.match?(d)
    puts "#{koyomi}"
  elsif one.match?(h)
    Enaga.help
  else
    puts 'Not Found Commands, Please enaga -h commad.'
  end
rescue Exception => e
  puts e.backtrace
  tanraku_execute
ensure
  GC.auto_compact
end

__END__
